package rpn

// ToRPN turns an infix expression of integers, + - * / and parentheses
// into Reverse Polish notation, one token per element: "3 + 4 * 2" gives
// ["3" "4" "2" "*" "+"]. Operators of equal precedence go left to right.
// Spaces between tokens do not matter. Unbalanced parentheses, an
// operator without operands or any other character is an error.
func ToRPN(expr string) ([]string, error) {
	panic("todo")
}

// EvalRPN computes RPN tokens as ToRPN writes them, with integer division
// truncating toward zero. Too few operands, leftover operands, division by
// zero or an unknown token is an error.
func EvalRPN(tokens []string) (int, error) {
	panic("todo")
}
-- project/rpn/rpn_test.go --
package rpn

import (
	"reflect"
	"testing"
)

func TestToRPN(t *testing.T) {
	for in, want := range map[string][]string{
		"3+4":       {"3", "4", "+"},
		"3 + 4 * 2": {"3", "4", "2", "*", "+"},
		"(3+4)*2":   {"3", "4", "+", "2", "*"},
		"10-4-3":    {"10", "4", "-", "3", "-"},
		"8/2/2":     {"8", "2", "/", "2", "/"},
		"2*(3+4)*5": {"2", "3", "4", "+", "*", "5", "*"},
		"((12))":    {"12"},
		"1+2*3-4/2": {"1", "2", "3", "*", "+", "4", "2", "/", "-"},
	} {
		got, err := ToRPN(in)
		if err != nil || !reflect.DeepEqual(got, want) {
			t.Errorf("ToRPN(%q) = %q, %v; want %q", in, got, err, want)
		}
	}
	for _, in := range []string{"", "(1+2", "1+2)", "1+", "*2", "1 2", "1+a"} {
		if _, err := ToRPN(in); err == nil {
			t.Errorf("ToRPN(%q): want an error", in)
		}
	}
}

func TestEvalRPN(t *testing.T) {
	for in, want := range map[string]int{"3+4*2": 11, "(3+4)*2": 14, "10-4-3": 3, "7/2": 3, "1+2*3-4/2": 5} {
		toks, err := ToRPN(in)
		if err != nil {
			t.Fatalf("ToRPN(%q): %v", in, err)
		}
		if got, err := EvalRPN(toks); err != nil || got != want {
			t.Errorf("EvalRPN(%q) = %d, %v; want %d", toks, got, err, want)
		}
	}
	for _, toks := range [][]string{{"1", "+"}, {"1", "2"}, {"1", "0", "/"}, {"1", "2", "^"}, {}} {
		if _, err := EvalRPN(toks); err == nil {
			t.Errorf("EvalRPN(%q): want an error", toks)
		}
	}
}
-- project/topo/topo.go --
package topo

// Sort orders the keys of deps so that every key comes after the keys it
// depends on (deps[k] lists k's dependencies). A dependency that is not a
// key is a key with no dependencies of its own. Among keys that are ready
// at the same time, the alphabetically first comes first, so the order is
// always the same. A cycle is an error.
func Sort(deps map[string][]string) ([]string, error) {
	panic("todo")
}
-- project/topo/topo_test.go --
package topo

import (
	"reflect"
	"testing"
)

func TestSort(t *testing.T) {
	for _, tc := range []struct {
		deps map[string][]string
		want []string
	}{
		{map[string][]string{}, []string{}},
		{map[string][]string{"a": nil}, []string{"a"}},
		{map[string][]string{"b": {"a"}}, []string{"a", "b"}},
		{map[string][]string{"c": {"a", "b"}, "b": {"a"}}, []string{"a", "b", "c"}},
		{map[string][]string{"x": nil, "b": nil, "a": nil}, []string{"a", "b", "x"}},
		{map[string][]string{"app": {"lib", "log"}, "lib": {"log"}, "test": {"app"}}, []string{"log", "lib", "app", "test"}},
		{map[string][]string{"d": {"b", "c"}, "c": {"a"}, "b": {"a"}}, []string{"a", "b", "c", "d"}},
	} {
		got, err := Sort(tc.deps)
		if err != nil || !reflect.DeepEqual(got, tc.want) {
			t.Errorf("Sort(%v) = %v, %v; want %v", tc.deps, got, err, tc.want)
		}
	}
	for _, deps := range []map[string][]string{{"a": {"a"}}, {"a": {"b"}, "b": {"a"}}, {"a": {"b"}, "b": {"c"}, "c": {"a"}, "d": nil}} {
		if _, err := Sort(deps); err == nil {
			t.Errorf("Sort(%v): want a cycle error", deps)
		}
	}
}
