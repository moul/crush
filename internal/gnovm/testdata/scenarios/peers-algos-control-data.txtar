package csvline

// Parse splits one CSV line into its fields. Fields are separated by
// commas; a field in double quotes may hold commas, and "" inside quotes
// is one ". Quotes in an unquoted field are kept as they are. An
// unterminated quoted field, or text after a closing quote other than a
// comma, is an error. An empty line is one empty field.
func Parse(line string) ([]string, error) {
	panic("todo")
}
-- project/csvline/csvline_test.go --
package csvline

import (
	"reflect"
	"testing"
)

func TestParse(t *testing.T) {
	for _, tc := range []struct {
		in   string
		want []string
	}{
		{"a,b,c", []string{"a", "b", "c"}},
		{"", []string{""}},
		{",", []string{"", ""}},
		{`"a,b",c`, []string{"a,b", "c"}},
		{`"say ""hi""",x`, []string{`say "hi"`, "x"}},
		{`a"b,c`, []string{`a"b`, "c"}},
		{`"",""`, []string{"", ""}},
		{` a , b `, []string{" a ", " b "}},
		{`"x"`, []string{"x"}},
		{`1,"two, three",4`, []string{"1", "two, three", "4"}},
	} {
		got, err := Parse(tc.in)
		if err != nil || !reflect.DeepEqual(got, tc.want) {
			t.Errorf("Parse(%q) = %q, %v; want %q", tc.in, got, err, tc.want)
		}
	}
	for _, in := range []string{`"abc`, `"a"b,c`, `x,"unterminated`} {
		if _, err := Parse(in); err == nil {
			t.Errorf("Parse(%q): want an error", in)
		}
	}
}
