package roman

// ToRoman writes n (1 to 3999) in Roman numerals, the subtractive way:
// 4 is IV, 9 is IX, 40 is XL, 90 is XC, 400 is CD, 900 is CM. Any other n
// is an error.
func ToRoman(n int) (string, error) {
	panic("todo")
}

// FromRoman reads a Roman numeral written as ToRoman writes it, and only
// that way: "IIII", "IC", "VX", lower case or an empty string are errors.
func FromRoman(s string) (int, error) {
	panic("todo")
}
-- project/roman/roman_test.go --
package roman

import "testing"

func TestToRoman(t *testing.T) {
	for n, want := range map[int]string{1: "I", 4: "IV", 9: "IX", 14: "XIV", 40: "XL", 90: "XC", 400: "CD", 1994: "MCMXCIV", 2026: "MMXXVI", 3999: "MMMCMXCIX"} {
		if got, err := ToRoman(n); err != nil || got != want {
			t.Errorf("ToRoman(%d) = %q, %v; want %q", n, got, err, want)
		}
	}
	for _, n := range []int{0, -1, 4000} {
		if _, err := ToRoman(n); err == nil {
			t.Errorf("ToRoman(%d): want an error", n)
		}
	}
}

func TestFromRoman(t *testing.T) {
	for n := 1; n <= 3999; n++ {
		s, _ := ToRoman(n)
		if got, err := FromRoman(s); err != nil || got != n {
			t.Fatalf("FromRoman(%q) = %d, %v; want %d", s, got, err, n)
		}
	}
	for _, s := range []string{"", "IIII", "IC", "VX", "MMMM", "xiv", "IIV", "XM", "VV", "ABC"} {
		if _, err := FromRoman(s); err == nil {
			t.Errorf("FromRoman(%q): want an error", s)
		}
	}
}
