-- project/lru/lru_test.go --
package lru

import "testing"

func TestCache(t *testing.T) {
	c := New(2)
	c.Put("a", 1)
	c.Put("b", 2)
	if v, ok := c.Get("a"); !ok || v != 1 {
		t.Fatalf("Get(a) = %d, %v", v, ok)
	}
	c.Put("c", 3) // evicts b, the least recently used
	if _, ok := c.Get("b"); ok {
		t.Fatal("b should have been evicted")
	}
	if v, ok := c.Get("c"); !ok || v != 3 {
		t.Fatalf("Get(c) = %d, %v", v, ok)
	}
	c.Put("a", 10) // update, a is now most recent
	c.Put("d", 4)  // evicts c
	if _, ok := c.Get("c"); ok {
		t.Fatal("c should have been evicted")
	}
	if v, _ := c.Get("a"); v != 10 {
		t.Fatalf("Get(a) = %d, want 10", v)
	}
	if c.Len() != 2 {
		t.Fatalf("Len = %d, want 2", c.Len())
	}

	big := New(100)
	for i := 0; i < 1000; i++ {
		big.Put(string(rune('a'+i%26))+string(rune('A'+i/26%26)), i)
	}
	if big.Len() != 100 {
		t.Fatalf("Len = %d, want 100", big.Len())
	}
	one := New(1)
	one.Put("x", 1)
	one.Put("y", 2)
	if _, ok := one.Get("x"); ok || one.Len() != 1 {
		t.Fatal("capacity 1 should hold only y")
	}
}
