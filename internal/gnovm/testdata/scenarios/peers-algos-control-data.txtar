package frac

// Frac is a fraction in lowest terms with a positive denominator.
type Frac struct{ Num, Den int64 }

// New makes num/den in lowest terms, the sign on the numerator: New(2, -4)
// is -1/2. A zero denominator panics.
func New(num, den int64) Frac {
	panic("todo")
}

// Add, Sub, Mul and Div compute in lowest terms; Div by zero panics.
func (a Frac) Add(b Frac) Frac { panic("todo") }
func (a Frac) Sub(b Frac) Frac { panic("todo") }
func (a Frac) Mul(b Frac) Frac { panic("todo") }
func (a Frac) Div(b Frac) Frac { panic("todo") }

// String is "3/4", "-1/2", or "2" when the denominator is 1.
func (a Frac) String() string { panic("todo") }
-- project/frac/frac_test.go --
package frac

import "testing"

func TestFrac(t *testing.T) {
	for _, tc := range []struct {
		got  Frac
		want string
	}{
		{New(2, 4), "1/2"},
		{New(2, -4), "-1/2"},
		{New(-6, -3), "2"},
		{New(0, 5), "0"},
		{New(1, 2).Add(New(1, 3)), "5/6"},
		{New(1, 2).Sub(New(3, 4)), "-1/4"},
		{New(2, 3).Mul(New(9, 4)), "3/2"},
		{New(1, 2).Div(New(1, 4)), "2"},
		{New(-3, 7).Div(New(3, -14)), "2"},
		{New(1, 6).Add(New(1, 6)).Add(New(1, 6)), "1/2"},
	} {
		if s := tc.got.String(); s != tc.want {
			t.Errorf("got %s (%+v), want %s", s, tc.got, tc.want)
		}
	}
	if f := New(4, -6); f.Num != -2 || f.Den != 3 {
		t.Errorf("New(4, -6) = %+v, want {-2 3}", f)
	}
	for _, f := range []func(){func() { New(1, 0) }, func() { New(1, 2).Div(New(0, 1)) }} {
		func() {
			defer func() {
				if recover() == nil {
					t.Error("want a panic")
				}
			}()
			f()
		}()
	}
}
