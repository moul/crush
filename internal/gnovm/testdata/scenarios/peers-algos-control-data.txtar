-- project/wrap/wrap_test.go --
package wrap

import (
	"reflect"
	"testing"
)

func TestWrap(t *testing.T) {
	for _, tc := range []struct {
		s     string
		width int
		want  []string
	}{
		{"the quick brown fox", 10, []string{"the quick", "brown fox"}},
		{"the quick brown fox", 9, []string{"the quick", "brown fox"}},
		{"the quick brown fox", 5, []string{"the", "quick", "brown", "fox"}},
		{"  lots   of\n spaces  ", 20, []string{"lots of spaces"}},
		{"abcdefghij", 4, []string{"abcd", "efgh", "ij"}},
		{"a abcdefghij b", 4, []string{"a", "abcd", "efgh", "ij b"}},
		{"héllo wörld", 5, []string{"héllo", "wörld"}},
		{"", 3, nil},
		{"   ", 3, nil},
		{"one", 3, []string{"one"}},
		{"one two", 7, []string{"one two"}},
		{"one two", 6, []string{"one", "two"}},
	} {
		if got := Wrap(tc.s, tc.width); !reflect.DeepEqual(got, tc.want) {
			t.Errorf("Wrap(%q, %d) = %q, want %q", tc.s, tc.width, got, tc.want)
		}
	}
	defer func() {
		if recover() == nil {
			t.Error("Wrap with width 0 did not panic")
		}
	}()
	Wrap("x", 0)
}
