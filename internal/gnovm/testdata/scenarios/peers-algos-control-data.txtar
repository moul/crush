-- project/eval/eval_test.go --
package eval

import (
	"math"
	"testing"
)

func TestEval(t *testing.T) {
	for in, want := range map[string]float64{
		"1+2":                 3,
		"2*3+4":               10,
		"2+3*4":               14,
		"(2+3)*4":             20,
		"10/4":                2.5,
		"8-3-2":               3,
		"16/4/2":              2,
		"-3+5":                2,
		"-(2+3)*2":            -10,
		"2*-3":                -6,
		" 1 + 2 * ( 3 - 1 ) ": 5,
		"0.5*0.5":             0.25,
		"((((7))))":           7,
		"1.25+2.75":           4,
		"--4":                 4,
	} {
		got, err := Eval(in)
		if err != nil || math.Abs(got-want) > 1e-9 {
			t.Errorf("Eval(%q) = %v, %v; want %v", in, got, err, want)
		}
	}
	for _, in := range []string{"", "1+", "(1+2", "1+2)", "2*/3", "1/0", "4 5", "a+1", "()", "3+(4*)"} {
		if _, err := Eval(in); err == nil {
			t.Errorf("Eval(%q): want an error", in)
		}
	}
}
