package lru

// Cache is a least-recently-used cache of string keys and int values that
// holds at most its capacity: putting a new key into a full cache first
// evicts the key used least recently (by Get or Put).
type Cache struct {
	// your fields
}

// New makes an empty cache of the given capacity (at least 1).
func New(capacity int) *Cache {
	panic("todo")
}

// Get returns the value for key and whether it was there, and marks key
// as just used.
