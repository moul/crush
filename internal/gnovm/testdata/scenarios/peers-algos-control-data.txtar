package intervals

// Merge merges intervals [start, end] (start <= end, ends included) that
// overlap or touch, like [1,3] and [3,5], or [1,3] and [4,6] which leave no
// integer between them, and returns them sorted by start. The input is not
// changed; nil or empty input gives an empty result. An interval with
// start > end is skipped.
func Merge(in [][2]int) [][2]int {
	panic("todo")
}
-- project/intervals/intervals_test.go --
package intervals

import (
	"reflect"
	"testing"
)

func TestMerge(t *testing.T) {
	for _, tc := range []struct {
		in, want [][2]int
	}{
		{nil, [][2]int{}},
		{[][2]int{{1, 3}}, [][2]int{{1, 3}}},
		{[][2]int{{1, 3}, {2, 6}, {8, 10}, {15, 18}}, [][2]int{{1, 6}, {8, 10}, {15, 18}}},
		{[][2]int{{1, 3}, {4, 6}}, [][2]int{{1, 6}}},
		{[][2]int{{1, 3}, {5, 6}}, [][2]int{{1, 3}, {5, 6}}},
		{[][2]int{{5, 6}, {1, 2}, {2, 4}}, [][2]int{{1, 6}}},
		{[][2]int{{1, 10}, {2, 3}, {4, 5}}, [][2]int{{1, 10}}},
		{[][2]int{{-5, -1}, {0, 0}, {3, 2}}, [][2]int{{-5, 0}}},
		{[][2]int{{7, 7}, {7, 7}}, [][2]int{{7, 7}}},
	} {
		in := append([][2]int(nil), tc.in...)
		got := Merge(tc.in)
		if !reflect.DeepEqual(got, tc.want) {
			t.Errorf("Merge(%v) = %v, want %v", tc.in, got, tc.want)
		}
		if !reflect.DeepEqual(in, tc.in) {
			t.Errorf("Merge changed its input: %v", tc.in)
		}
	}
}
