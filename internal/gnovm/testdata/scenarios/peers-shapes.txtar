-- project/circle/area.go --
package circle

// Area is its area.
func (s Circle) Area() float64 {
	panic("todo")
}
-- project/circle/area_test.go --
package circle

import (
	"math"
	"testing"
)

func TestArea(t *testing.T) {
	for _, tc := range []struct {
		s    Circle
		want float64
	}{
		{Circle{0, 0, 1}, math.Pi},
		{Circle{3, -2, 2}, 4 * math.Pi},
		{Circle{1, 1, 0}, 0},
		{Circle{0, 0, 0.5}, 0.25 * math.Pi},
	} {
		if got := tc.s.Area(); math.Abs(got-tc.want) > 1e-9 {
			t.Errorf("%+v.Area() = %v, want %v", tc.s, got, tc.want)
		}
	}
}
