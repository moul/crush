A heavier plan for peers (PARALLEL.md, B): the geom module of peers-geom with
four methods per shape (Area, Perimeter, Scale, Contains), each its own file
and table test, so a todo is real work and a session's start counts for
less. Run with GNOVM_SCENARIO_PEERS=1 for one session and 3 for three at
once; both must end with every test passing, the tests untouched and every
todo done.

-- peers --
3
-- mem --
g := mem.Todo("make the geom module pass go test ./...").Parallel()
a := g.Todo("circle: go test ./circle/ passes").Parallel()
a.Todo("implement Circle.Area in circle/area.go so go test -run Area ./circle/ passes")
a.Todo("implement Circle.Perimeter in circle/perimeter.go so go test -run Perimeter ./circle/ passes")
a.Todo("implement Circle.Scale in circle/scale.go so go test -run Scale ./circle/ passes")
a.Todo("implement Circle.Contains in circle/contains.go so go test -run Contains ./circle/ passes")
b := g.Todo("square: go test ./square/ passes").Parallel()
b.Todo("implement Square.Area in square/area.go so go test -run Area ./square/ passes")
b.Todo("implement Square.Perimeter in square/perimeter.go so go test -run Perimeter ./square/ passes")
b.Todo("implement Square.Scale in square/scale.go so go test -run Scale ./square/ passes")
b.Todo("implement Square.Contains in square/contains.go so go test -run Contains ./square/ passes")
c := g.Todo("triangle: go test ./triangle/ passes").Parallel()
c.Todo("implement Triangle.Area in triangle/area.go so go test -run Area ./triangle/ passes")
c.Todo("implement Triangle.Perimeter in triangle/perimeter.go so go test -run Perimeter ./triangle/ passes")
c.Todo("implement Triangle.Scale in triangle/scale.go so go test -run Scale ./triangle/ passes")
c.Todo("implement Triangle.Contains in triangle/contains.go so go test -run Contains ./triangle/ passes")
