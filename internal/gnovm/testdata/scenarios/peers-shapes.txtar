)

func TestScale(t *testing.T) {
	for _, tc := range []struct {
		s    Triangle
		k    float64
		want Triangle
	}{
		{Triangle{0, 0, 4, 0, 0, 3}, 2, Triangle{0, 0, 8, 0, 0, 6}},
		{Triangle{1, 1, 3, 1, 2, 4}, 0.5, Triangle{1, 1, 2, 1, 1.5, 2.5}},
		{Triangle{2, 2, 4, 6, 0, 0}, -1, Triangle{2, 2, 0, -2, 4, 4}},
	} {
		got := tc.s.Scale(tc.k)
		g, w := reflect.ValueOf(got), reflect.ValueOf(tc.want)
		for i := 0; i < g.NumField(); i++ {
			if math.Abs(g.Field(i).Float()-w.Field(i).Float()) > 1e-9 {
				t.Errorf("%+v.Scale(%v) = %+v, want %+v", tc.s, tc.k, got, tc.want)
				break
			}
		}
	}
}
