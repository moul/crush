-- project/circle/contains_test.go --
package circle

import "testing"

func TestContains(t *testing.T) {
	for _, tc := range []struct {
		s    Circle
		x, y float64
		want bool
	}{
		{Circle{0, 0, 1}, 0, 0, true},
		{Circle{0, 0, 1}, 1, 0, true},
		{Circle{0, 0, 1}, 0.8, 0.8, false},
		{Circle{2, 2, 1}, 2.5, 2.5, true},
		{Circle{2, 2, 1}, 0, 0, false},
	} {
		if got := tc.s.Contains(tc.x, tc.y); got != tc.want {
			t.Errorf("%+v.Contains(%v, %v) = %v, want %v", tc.s, tc.x, tc.y, got, tc.want)
		}
	}
}
