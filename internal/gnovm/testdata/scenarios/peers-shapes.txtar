-- project/circle/perimeter_test.go --
package circle

import (
	"math"
	"testing"
)

func TestPerimeter(t *testing.T) {
	for _, tc := range []struct {
		s    Circle
		want float64
	}{
		{Circle{0, 0, 1}, 2 * math.Pi},
		{Circle{5, 5, 3}, 6 * math.Pi},
		{Circle{0, 0, 0}, 0},
	} {
		if got := tc.s.Perimeter(); math.Abs(got-tc.want) > 1e-9 {
			t.Errorf("%+v.Perimeter() = %v, want %v", tc.s, got, tc.want)
		}
	}
}
-- project/circle/scale.go --
package circle

// Scale returns it scaled by k about its centre: every distance from its centre times k.
func (s Circle) Scale(k float64) Circle {
	panic("todo")
}
-- project/circle/scale_test.go --
package circle

import (
	"math"
	"reflect"
	"testing"
)

func TestScale(t *testing.T) {
	for _, tc := range []struct {
		s    Circle
		k    float64
		want Circle
	}{
		{Circle{1, 2, 3}, 2, Circle{1, 2, 6}},
		{Circle{0, 0, 4}, 0.5, Circle{0, 0, 2}},
		{Circle{-3, 3, 1}, 0, Circle{-3, 3, 0}},
	} {
		got := tc.s.Scale(tc.k)
		g, w := reflect.ValueOf(got), reflect.ValueOf(tc.want)
		for i := 0; i < g.NumField(); i++ {
			if math.Abs(g.Field(i).Float()-w.Field(i).Float()) > 1e-9 {
				t.Errorf("%+v.Scale(%v) = %+v, want %+v", tc.s, tc.k, got, tc.want)
				break
			}
		}
	}
}
