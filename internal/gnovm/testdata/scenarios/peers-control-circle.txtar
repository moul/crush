package triangle

import (
	"math"
	"testing"
)

func TestPerimeter(t *testing.T) {
	for _, tc := range []struct {
		s    Triangle
		want float64
	}{
		{Triangle{A: 3, B: 4, C: 5}, 12},
		{Triangle{A: 1, B: 1, C: 1}, 3},
		{Triangle{A: 5, B: 5, C: 6}, 16},
	} {
		if got := tc.s.Perimeter(); math.Abs(got-tc.want) > 1e-9 {
			t.Errorf("%+v.Perimeter() = %v, want %v", tc.s, got, tc.want)
		}
	}
}
