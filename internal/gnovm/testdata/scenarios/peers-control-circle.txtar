The control for peers-geom (PARALLEL.md, B): the circle part of its plan alone,
on a copy of the whole project with a mem of its own. peers-control-circle,
-square and -triangle run at once show how fast three sessions can do the
three shapes on this box with no plan shared, the bar the peers are
measured against.

-- mem --
c := mem.Todo("circle: go test ./circle/ passes").Parallel()
c.Todo("implement Circle.Area in circle/area.go so go test -run Area ./circle/ passes")
c.Todo("implement Circle.Perimeter in circle/perimeter.go so go test -run Perimeter ./circle/ passes")
-- prompt-new --
Work through the plan in mem until nothing is left for you.
-- check --
cmd go test ./circle/
cmd echo '04d22e7b6cefbfd8d2d77e3227a05e891bb36c38aa5816f72ca869575b155e24  circle/area_test.go' | sha256sum -c --quiet
cmd echo 'a02f829e2fd05fdc7e7e85e2b5156931864f8f3d9149675bbb0f729f179ec9b9  circle/perimeter_test.go' | sha256sum -c --quiet
mem-count done >= 3
mem-count open == 0
-- project/circle/area.go --
package circle

// Area is the circle's area: pi r squared.
func (s Circle) Area() float64 {
	panic("todo")
}
-- project/circle/area_test.go --
package circle

import (
	"math"
	"testing"
)

func TestArea(t *testing.T) {
	for _, tc := range []struct {
		s    Circle
		want float64
	}{
		{Circle{R: 1}, math.Pi},
		{Circle{R: 2}, 4 * math.Pi},
		{Circle{R: 0}, 0},
	} {
		if got := tc.s.Area(); math.Abs(got-tc.want) > 1e-9 {
			t.Errorf("%+v.Area() = %v, want %v", tc.s, got, tc.want)
		}
	}
}
-- project/circle/circle.go --
package circle

// Circle is a circle of radius R.
type Circle struct{ R float64 }
