The control for peers-geom (PARALLEL.md, B): the square part of its plan alone,
on a copy of the whole project with a mem of its own. peers-control-circle,
-square and -triangle run at once show how fast three sessions can do the
three shapes on this box with no plan shared, the bar the peers are
measured against.

-- mem --
c := mem.Todo("square: go test ./square/ passes").Parallel()
c.Todo("implement Square.Area in square/area.go so go test -run Area ./square/ passes")
c.Todo("implement Square.Perimeter in square/perimeter.go so go test -run Perimeter ./square/ passes")
-- prompt-new --
Work through the plan in mem until nothing is left for you.
-- check --
cmd go test ./square/
cmd echo '32a16babe43e3051db830899023ff9c12e4c7c7863f99f3852bd4c1fec936e75  square/area_test.go' | sha256sum -c --quiet
cmd echo '9394c311ea7aa60da31dd8e5dd27c759feb887e3ff7b91dcccbe4cae531e0596  square/perimeter_test.go' | sha256sum -c --quiet
mem-count done >= 3
mem-count open == 0
-- project/circle/area.go --
package circle

// Area is the circle's area: pi r squared.
func (s Circle) Area() float64 {
	panic("todo")
}
-- project/circle/area_test.go --
package circle

import (
	"math"
	"testing"
)

func TestArea(t *testing.T) {
	for _, tc := range []struct {
		s    Circle
		want float64
	}{
		{Circle{R: 1}, math.Pi},
		{Circle{R: 2}, 4 * math.Pi},
		{Circle{R: 0}, 0},
	} {
		if got := tc.s.Area(); math.Abs(got-tc.want) > 1e-9 {
			t.Errorf("%+v.Area() = %v, want %v", tc.s, got, tc.want)
		}
	}
}
