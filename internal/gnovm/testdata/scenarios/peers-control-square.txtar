-- project/triangle/area.go --
package triangle

// Area is the triangle's area, from its three sides (Heron's formula).
func (s Triangle) Area() float64 {
	panic("todo")
}
-- project/triangle/area_test.go --
package triangle

import (
	"math"
	"testing"
)

func TestArea(t *testing.T) {
	for _, tc := range []struct {
		s    Triangle
		want float64
	}{
		{Triangle{A: 3, B: 4, C: 5}, 6},
		{Triangle{A: 1, B: 1, C: 1}, math.Sqrt(3) / 4},
		{Triangle{A: 5, B: 5, C: 6}, 12},
	} {
		if got := tc.s.Area(); math.Abs(got-tc.want) > 1e-9 {
			t.Errorf("%+v.Area() = %v, want %v", tc.s, got, tc.want)
		}
	}
}
