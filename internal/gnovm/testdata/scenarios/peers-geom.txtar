package circle

import (
	"math"
	"testing"
)

func TestPerimeter(t *testing.T) {
	for _, tc := range []struct {
		s    Circle
		want float64
	}{
		{Circle{R: 1}, 2 * math.Pi},
		{Circle{R: 0.5}, math.Pi},
		{Circle{R: 0}, 0},
	} {
		if got := tc.s.Perimeter(); math.Abs(got-tc.want) > 1e-9 {
			t.Errorf("%+v.Perimeter() = %v, want %v", tc.s, got, tc.want)
		}
	}
}
